{
    "bootloader": "rp2040",

	"build": {
		"firmware_format": "uf2",
		"lto": true
	},

	"diode_direction": "COL2ROW",

    "matrix_pins": {
        "cols": [ "GP21", "GP23" ],
        "rows": [ "GP16", "GP15" ]
    },

	"pin_compatible": "elite_c",

    "processor": "RP2040",

	"usb": {
        "device_version": "0.0.9",
		"shared_endpoint": {
			"keyboard": true,
			"mouse": true
		}
    },

	"ws2812": {
		"driver": "vendor",
		"pin": "NO_PIN",
		"rgbw": false
	},




    "features": {
		"audio": false,
		"auto_shift": false,
		"autocorrect": false,
		"backlight": false,
		"battery": false,
		"bootmagic": true,
		"blutooth": false,
		"caps_word": true,
		"combo": true,
		"command": false,
		"digitizer": false,
		"dip_switch": false,
		"dip_switch_map": false,
		"dynamic_macro": false,
		"encoder": true,
		"encoder_map": true,
		"haptic": false,
		"hd44780": false,
		"joystick": false,
		"key_lock": false,
		"key_override": false,
		"layer_lock": true,
		"leader": false,
		"midi": false,
		"mousekey": true,
		"nkro": true,
		"oled": true,
		"os_detection": false,
		"pointing_device": false,
		"programmable_button": false,
		"ps2": false,
		"ps2_mouse": false,
		"raw": false,
		"repeat_key": false,
		"rgb_matrix": false,
		"rgblight": true,
		"secure": false,
		"send_string": false,
		"sequencer": false,
		"split": false,
		"split_led_state": false,
		"st7565": false,
		"steno": false,
		"swap_hands": false,
		"tap_dance": false,
		"tri_layer": false,
		"unicode_common": false,
		"via": false,
		"wireless": false,
		"wpm": false

    },

	"encoder": {
		"rotary": [
			{ "pin_a": "NO_PIN", "pin_b": "NO_PIN", "resolution": 2 },
			{ "pin_a": "NO_PIN", "pin_b": "NO_PIN", "resolution": 2 }
		]
	},

	"rgblight": {
		"driver": "ws2812",
		"led_count": 1
	},




    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [1, 0], "x": 0, "y": 1 },
                { "matrix": [1, 1], "x": 1, "y": 1 }
            ]
        }
    }
}
