{
    "bootloader": "rp2040",

	"build": {
		"firmware_format": "uf2",
		"lto": true
	},

	"diode_direction": "COL2ROW",

	"encoder": {
		"rotary": [
			{ "pin_a": "GP5", "pin_b": "GP6", "resolution": 2 },
			{ "pin_a": "GP26", "pin_b": "GP22", "resolution": 2 }
		]
	},

    "matrix_pins": {
        "cols": [ "GP9", "GP8", "GP7", "GP4", "GP1", "GP0", "GP29", "GP28", "GP27", "GP20", "GP23", "GP21" ],
        "rows": [ "GP16", "GP15", "GP14", "GP13", "GP12" ]
    },

	"pin_compatible": "elite_c",

    "processor": "RP2040",

	"usb": {
        "device_version": "1.0.0",
		"shared_endpoint": {
			"keyboard": true,
			"mouse": true
		}
    },

	"ws2812": {
		"driver": "vendor",
		"pin": "GP25",
		"rgbw": false
	},




    "features": {
		"audio": false,
		"auto_shift": false,
		"autocorrect": false,
		"backlight": false,
		"battery": false,
		"bootmagic": true,
		"blutooth": false,
		"caps_word": true,
		"combo": true,
		"command": false,
		"console": true,
		"digitizer": false,
		"dip_switch": false,
		"dip_switch_map": false,
		"dynamic_macro": false,
		"encoder": true,
		"encoder_map": true,
		"haptic": false,
		"hd44780": false,
		"joystick": false,
		"key_lock": false,
		"key_override": false,
		"layer_lock": true,
		"leader": false,
		"midi": false,
		"mousekey": true,
		"nkro": true,
		"oled": true,
		"os_detection": false,
		"pointing_device": false,
		"programmable_button": false,
		"ps2": false,
		"ps2_mouse": false,
		"raw": false,
		"repeat_key": false,
		"rgb_matrix": false,
		"rgblight": true,
		"secure": false,
		"send_string": false,
		"sequencer": false,
		"split": false,
		"split_led_state": false,
		"st7565": false,
		"steno": false,
		"swap_hands": false,
		"tap_dance": false,
		"tri_layer": false,
		"unicode_common": false,
		"via": false,
		"wireless": false,
		"wpm": false

    },

	"caps_word": {
		"both_shifts_turns_on": true
	},

	"dynamic_keymap": {
		"layer_count": 8
	},

	"oneshot": {
		"tap_toggle": 5,
		"timeout": 5000
	},

	"rgblight": {
		"driver": "ws2812",
		"led_count": 1,
		"max_brightness": 64,
		"sleep": true,
		"animations": {
			"static_light": true,
			"breathing": true,
			"rainbow_mood": true
		},
		"default": {
			"on": true,
			"animation": "breathing",
			"hue": 201,
			"sat": 255,
			"speed": 65,
			"val": 64
		}
	},

	"tapping": {
		"force_hold": false,
		"force_hold_per_key": true,
		"hold_on_other_key_press": false,
		"hold_on_other_key_press_per_key": true,
		"ignore_mod_tap_interrupt": true,
		"permissive_hold": true,
		"permissive_hold_per_key": false,
		"quick_tap_term_per_key": true,
		"retro": false,
		"retro_per_key": false,
		"term": 200,
		"term_per_key": false,
		"toggle": 2

	},



	"layout_aliases": {
		"LAYOUT_yubi": "LAYOUT_ortho_5x12"
	},

    "layouts": {
        "LAYOUT_ortho_5x12": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [0, 2], "x": 2, "y": 0 },
                { "matrix": [0, 3], "x": 3, "y": 0 },
                { "matrix": [0, 4], "x": 4, "y": 0 },
                { "matrix": [0, 5], "x": 5, "y": 0 },

				{ "matrix": [0, 6], "x": 6, "y": 0 },
                { "matrix": [0, 7], "x": 7, "y": 0 },
                { "matrix": [0, 8], "x": 8, "y": 0 },
                { "matrix": [0, 9], "x": 9, "y": 0 },
                { "matrix": [0, 10], "x": 10, "y": 0 },
                { "matrix": [0, 11], "x": 11, "y": 0 },



                { "matrix": [1, 0], "x": 0, "y": 0 },
                { "matrix": [1, 1], "x": 1, "y": 0 },
                { "matrix": [1, 2], "x": 2, "y": 0 },
                { "matrix": [1, 3], "x": 3, "y": 0 },
                { "matrix": [1, 4], "x": 4, "y": 0 },
                { "matrix": [1, 5], "x": 5, "y": 0 },

				{ "matrix": [1, 6], "x": 6, "y": 0 },
                { "matrix": [1, 7], "x": 7, "y": 0 },
                { "matrix": [1, 8], "x": 8, "y": 0 },
                { "matrix": [1, 9], "x": 9, "y": 0 },
                { "matrix": [1, 10], "x": 10, "y": 0 },
                { "matrix": [1, 11], "x": 11, "y": 0 },



                { "matrix": [2, 0], "x": 0, "y": 0 },
                { "matrix": [2, 1], "x": 1, "y": 0 },
                { "matrix": [2, 2], "x": 2, "y": 0 },
                { "matrix": [2, 3], "x": 3, "y": 0 },
                { "matrix": [2, 4], "x": 4, "y": 0 },
                { "matrix": [2, 5], "x": 5, "y": 0 },

				{ "matrix": [2, 6], "x": 6, "y": 0 },
                { "matrix": [2, 7], "x": 7, "y": 0 },
                { "matrix": [2, 8], "x": 8, "y": 0 },
                { "matrix": [2, 9], "x": 9, "y": 0 },
                { "matrix": [2, 10], "x": 10, "y": 0 },
                { "matrix": [2, 11], "x": 11, "y": 0 },



                { "matrix": [3, 0], "x": 0, "y": 0 },
                { "matrix": [3, 1], "x": 1, "y": 0 },
                { "matrix": [3, 2], "x": 2, "y": 0 },
                { "matrix": [3, 3], "x": 3, "y": 0 },
                { "matrix": [3, 4], "x": 4, "y": 0 },
                { "matrix": [3, 5], "x": 5, "y": 0 },

                { "matrix": [4, 5], "x": 5, "y": 0 },
				{ "matrix": [4, 6], "x": 6, "y": 0 },

				{ "matrix": [3, 6], "x": 6, "y": 0 },
                { "matrix": [3, 7], "x": 7, "y": 0 },
                { "matrix": [3, 8], "x": 8, "y": 0 },
                { "matrix": [3, 9], "x": 9, "y": 0 },
                { "matrix": [3, 10], "x": 10, "y": 0 },
                { "matrix": [3, 11], "x": 11, "y": 0 },



                { "matrix": [4, 1], "x": 1, "y": 0 },
                { "matrix": [4, 3], "x": 3, "y": 0 },
                { "matrix": [4, 4], "x": 4, "y": 0 },
                { "matrix": [4, 2], "x": 2, "y": 0 },

				{ "matrix": [4, 9], "x": 9, "y": 0 },
                { "matrix": [4, 7], "x": 7, "y": 0 },
                { "matrix": [4, 8], "x": 8, "y": 0 },
                { "matrix": [4, 10], "x": 10, "y": 0 }
			]
        }
    }
}
