{
	"manufacturer": "abstruse systems",
	"keyboard_name": "yubi",
	"maintainer": "dylanmcauliffe",
	"bootloader": "tinyuf2",
	"diode_direction": "COL2ROW",
	"features": {
		"audio": false,
		"bootmagic": true,
		"command": true,
		"console": true,
		"encoder": true,
		"encoder_map": true,
		"extrakey": true,
		"mousekey": true,
		"nkro": true,
		"oled": false,
		"via": true,
	},
	"build": {
		"lto": true,
	},
	"caps_word": {
		"enabled": true,
		"both_shifts_turns_on": true,
	}
	"encoder": {
		"rotary": [
			{
				"pin_a": "C13",
				"pin_b": "C14",
				"resolution": 2
			},{
				"pin_a": "A1",
				"pin_b": "A0",
				"resolution": 2
			},
		]
	},
	"lighting": "none",
	"matrix_pins": {
		"cols": ["B10", "B2", "B1", "B0", "A15", "B3"],
		"rows": ["B4", "A5", "B5", "A6", "B8", "A7", "B9", "A4"]
	},
	"processor": "STM32F411",
	"tapping": {
		"force_hold_per_key": true,
		"ignore_mod_tap_interrupt": true,
		"permissive_hold_per_key": true,
		"term": 150,
		"term_per_key": false,
		"toggle": 2
	},
	"url": "",
	"usb": {
		"vid": "0xAB17"
		"pid": "0xCB13",
		"device_version": "0.0.5",
		"shared_endpoint": {
			"keyboard": true,
			"mouse": true,
		},
	},
	"layouts": {
		"LAYOUT_yubi_v5a": {
			"layout": [
				{ "matrix": [0, 0], "x": 0, "y": 0 },
				{ "matrix": [0, 1], "x": 1, "y": 0 },
				{ "matrix": [0, 2], "x": 2, "y": 0 },
				{ "matrix": [0, 3], "x": 3, "y": 0 },
				{ "matrix": [0, 4], "x": 4, "y": 0 },
				{ "matrix": [0, 5], "x": 5, "y": 0 },
				
				{ "matrix": [1, 5], "x": 8, "y": 0 },
				{ "matrix": [1, 4], "x": 9, "y": 0 },
				{ "matrix": [1, 3], "x": 10, "y": 0 },
				{ "matrix": [1, 2], "x": 11, "y": 0 },
				{ "matrix": [1, 1], "x": 12, "y": 0 },
				{ "matrix": [1, 0], "x": 13, "y": 0 },
				
				{ "matrix": [2, 0], "x": 0, "y": 1 },
				{ "matrix": [2, 1], "x": 1, "y": 1 },
				{ "matrix": [2, 2], "x": 2, "y": 1 },
